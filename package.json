		"test": "bun test"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"drizzle-orm": "^0.45.4",
		"ws": "^8.23.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
